#include <unification.xh>

#ifndef _PROLOG_UTILS_H
#define _PROLOG_UTILS_H

template<typename a>
datatype maybe {
  nothing();
  just(a);
};

#define mod(a, b) ((a) % (b))

// Non-list utility predicates
prolog {
  repeat();
  repeat().
  repeat() :- repeat().
  
  between<typename a>(a, a, a ?);
  between(L, H, L).
  % TODO: Currently this depends on type errors for + and =< not yet being checked,
  % we need some notion of a numeric-constrained type variable.
  between(L, H, N) :- L1 is ((a)(L + 1)), L1 =< H, between(L1, H, N).

  var<typename a>(a ?v);
  var(_) :- (is_bound(v)) =:= 0 .

  nonvar<typename a>(a ?v);
  nonvar(_) :- (is_bound(v)) =:= 1 .
}

#endif
