#include <unification.xh>
#include <list.xh>
#include <stdlib.h>
#include <stdio.h>

#ifndef _MAP_XH
#define _MAP_XH

template<typename k, typename v, int (*cmp)(k, k)>
datatype map {
  Node(k ?key, v ?value, map<k, v, cmp> ?left, map<k, v, cmp> ?right);
  Empty();
};

prolog {
  emptyMap<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> ?m1);
  mapContains<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> m1, k key, v ?value);
  mapContainsValue<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> ?m1, k ?key, v ?value);
  mapInsert<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> m1, k key, v ?value, map<k, v, cmp> ?m2);
  mapDelete<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> m1, k key, map<k, v, cmp> ?m2);
  mapSelectMin<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> ?m1, k ?key, v ?value, map<k, v, cmp> ?m2);
  mapSelectMax<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> ?m1, k ?key, v ?value, map<k, v, cmp> ?m2);
  mapKeys<typename k, typename v, int (*cmp)(k, k)>(map<k, v, cmp> ?m, list<k ?> ?keys, v value);
  #include "map.pl"
}

// Utilities for pure, aliased, arena-allocated maps
template<typename k, typename v, int (*cmp)(k, k)>
map<k, v, cmp> ?emptyMap(arena_t ar) {
  allocate_using arena ar;
  return new var(Empty<k, v, cmp>());
}

template<typename k, typename v, int (*cmp)(k, k)>
_Bool mapContains(map<k, v, cmp> ?m, k key) {
  return match (m)
    (?&Node(?&key1, _, l, r) @when(cmp(key1, key) > 0) -> mapContains(l, key);
     ?&Node(?&key1, _, l, r) @when(cmp(key1, key) < 0) -> mapContains(r, key);
     ?&Node(_, _, l, r) -> 1;
     ?&Empty() -> 0;);
}

template<typename k, typename v, int (*cmp)(k, k)>
v mapGet(map<k, v, cmp> ?m, k key) {
  return match (m)
    (?&Node(?&key1, _, l, r) @when(cmp(key1, key) > 0) -> mapGet(l, key);
     ?&Node(?&key1, _, l, r) @when(cmp(key1, key) < 0) -> mapGet(r, key);
     ?&Node(_, ?&value, l, r) -> value;
     ?&Empty() -> ({
         allocate_using stack;
         fprintf(stderr, "Key %s not in map\n", show(key).text);
         abort();
         // Unreachable, needed since pattern RHS must have type v
         v res;
         res;
       }););
}

template<typename k, typename v, int (*cmp)(k, k)>
map<k, v, cmp> ?mapInsert(map<k, v, cmp> ?m, k key, v value, arena_t ar) {
  allocate_using arena ar;
  return match (m)
    (?&Node(k@?&key1, v, l, r) @when(cmp(key1, key) > 0) ->
       new var(Node(k, v, mapInsert(l, key, value, ar), r));
     ?&Node(k@?&key1, v, l, r) @when(cmp(key1, key) < 0) ->
       new var(Node(k, v, l, mapInsert(r, key, value, ar)));
     ?&Node(_, _, l, r) ->
       new var(Node(new var(key), new var(value), l, r));
     ?&Empty() ->
       // m is empty
       new var(Node(new var(key), new var(value), m, m)););
}

template<typename k, typename v, int (*cmp)(k, k)>
k mapGetMaxKey(map<k, v, cmp> ?m) {
  return match (m)
    (?&Node(?&key, _, _, ?&Empty()) -> key;
     ?&Node(_, _, _, r) -> mapGetMaxKey(r);
     ?&Empty() -> ({
         allocate_using stack;
         fprintf(stderr, "Map is empty\n");
         abort();
         // Unreachable, needed since pattern RHS must have type k
         k res;
         res;
       }););
}

template<typename k, typename v, int (*cmp)(k, k)>
map<k, v, cmp> ?mapDelete(map<k, v, cmp> ?m, k key, arena_t ar) {
  allocate_using arena ar;
  return match (m)
    (?&Node(k@?&key1, v, l, r) @when(cmp(key1, key) > 0) ->
       new var(Node(k, v, mapDelete(l, key, ar), r));
     ?&Node(k@?&key1, v, l, r) @when(cmp(key1, key) < 0) ->
       new var(Node(k, v, l, mapDelete(r, key, ar)));
     ?&Node(_, _, ?&Empty(), r) -> r;
     ?&Node(_, _, l, r) -> ({
         k maxKey = mapGetMaxKey(l);
         new var(Node(new var(maxKey), new var(mapGet(l, maxKey)), mapDelete(l, maxKey, ar), r));
       });
     ?&Empty() -> ({
         allocate_using stack;
         fprintf(stderr, "Key %s not in map\n", show(key).text);
         abort();
         // Unreachable, needed since pattern RHS must have type map<k, v, cmp> ?
         map<k, v, cmp> ?res;
         res;
       }););
}

template<typename k, typename v, int (*cmp)(k, k)>
map<k, v, cmp> ?copyMap(map<k, v, cmp> ?m, arena_t ar) {
  allocate_using arena ar;
  return match (m)
    (?&Node(k, v, l, r) -> new var(Node(k, v, copyMap(l, ar), copyMap(r, ar)));
     ?&Empty() -> new var(Empty<k, v, cmp>()););
}

// Utilities for mutable, non-aliased, heap allocated maps
template<typename k, typename v, int (*cmp)(k, k)>
map<k, v, cmp> ?newMap() {
  allocate_using heap;
  return new var(Empty<k, v, cmp>());
}

template<typename k, typename v, int (*cmp)(k, k)>
void freeMap(map<k, v, cmp> ?m) {
  allocate_using heap;
  match (m) {
    ?&Node(k, v, l, r) -> {
      delete k;
      delete v;
      freeMap(l);
      freeMap(r);
    }
  }
  delete m;
}

template<typename k, typename v, int (*cmp)(k, k)>
void mapInsertMut(map<k, v, cmp> ?m, k key, v value) {
  allocate_using heap;
  match (m) {
    ?&Node(k@?&key1, _, l, r) @when(cmp(key1, key) > 0) -> {
      mapInsertMut(l, key, value);
    }
    ?&Node(k@?&key1, _, l, r) @when(cmp(key1, key) < 0) -> {
      mapInsertMut(r, key, value);
    }
    ?&Node(k, v, l, r) -> {
      set_var(k, key);
      set_var(v, value);
    }
    ?&Empty() -> {
      set_var(m, Node(
        new var(key), new var(value),
        new var(Empty<k, v, cmp>()), new var(Empty<k, v, cmp>())));
    }
  }
}

template<typename k, typename v, int (*cmp)(k, k)>
void mapDeleteMut(map<k, v, cmp> ?m, k key) {
  allocate_using heap;
  match (m) {
    ?&Node(k@?&key1, _, l, r) @when(cmp(key1, key) > 0) -> {
      mapDeleteMut(l, key);
    }
    ?&Node(k@?&key1, _, l, r) @when(cmp(key1, key) < 0) -> {
      mapDeleteMut(r, key);
    }
    ?&Node(k, v, l@?&Empty(), r) -> {
      set_var(m, value(r));
      delete k;
      delete v;
      delete l;
      delete r;
    }
    ?&Node(k1, v1, l, r) -> {
      k maxKey = mapGetMaxKey(l);
      set_var(k1, maxKey);
      set_var(v1, mapGet(l, maxKey));
      mapDeleteMut(l, maxKey);
    }
    ?&Empty() -> {
      fprintf(stderr, "Key %s not in map\n", show(key).text);
      abort();
    }
  }
}

#endif
