#include <unification.xh>
#include <prolog_utils.xh>
#include <stdlib.h>

#ifndef _LIST_XH
#define _LIST_XH

template<typename a>
datatype _list_d {
  _Cons(a head, list<a> ?tail);
  _Nil();
};

template<typename a>
list<a> ?cons(a head, list<a> ?tail, arena_t ar) {
  allocate_using arena ar;
  return (list<a>?)new var<_list_d<a>>(_Cons(head, tail));
}

template<typename a>
list<a> ?nil(arena_t ar) {
  allocate_using arena ar;
  return (list<a>?)new var<_list_d<a>>(_Nil<a>());
}

template<typename a>
_Bool null(list<a> ?l) {
  return value(l)->tag == _list_d__Nil;
}

template<typename a>
a head(list<a> ?l) {
  match (value(l)) {
    [h | t] -> { return h; }
    [] -> {
      fprintf(stderr, "Error: Cannot access head of empty list\n");
      exit(1);
    }
  }
}

template<typename a>
list<a> ?tail(list<a> ?l) {
  match (value(l)) {
    [h | t] -> { return t; }
    [] -> {
      fprintf(stderr, "Error: Cannot access tail of empty list\n");
      exit(1);
    }
  }
}

template<typename a>
list<a> ?appendList(list<a> ?l1, list<a> ?l2, arena_t ar) {
  allocate_using arena ar;
  return match (value(l1))
    ([h | t] -> newlist[h | appendList(t, l2, ar)];
     [] -> l2;);
}

template<typename a>
list<a> ?replicateList(size_t n, a value, arena_t ar) {
  allocate_using arena ar;
  return n == 0? nil<a>(ar) : cons(value, replicateList(n - 1, value, ar), ar);
}

template<typename a>
a nthList(list<a> ?l, size_t n) {
  return match (l)
    (?&[h | t] -> n == 0? h : nthList(t, n - 1);
     ?&[] -> ({
         allocate_using stack;
         fprintf(stderr, "Error: Cannot access %zu-th element of empty list\n", n);
         abort();
         // Unreachable, needed since pattern RHS must have type a
         a res;
         res;
       });
    );
}

template<typename a>
list<a> ?copyList(list<a> ?l, a (*copyItem)(a, arena_t), arena_t ar) {
  allocate_using arena ar;
  return match (l)
    (?&[h | t] -> cons(copyItem? copyItem(h, ar) : h, copyList(t, copyItem, ar), ar);
     ?&[] -> l;);
}

template<typename a>
size_t _show_list_contents_max_len(list<a> l) {
  return match (l)
    ([h | ?&(t@[_ | _])] -> showMaxLen(h) + 2 + _show_list_contents_max_len(t);
     [h] -> showMaxLen(h);
     [h | v@freevar] -> showMaxLen(h) + 3 + showMaxLen(v);
     [] -> 0;);
}

template<typename a>
size_t _show_list_contents_to_buf(char *buf, list<a> l) {
  match (l) {
    [h | ?&(t@[_ | _])] -> {
      size_t len = showToBuf(buf, h);
      buf[len++] = ',';
      buf[len++] = ' ';
      return len + _show_list_contents_to_buf(buf + len, t);
    }
    [h] -> {
      return showToBuf(buf, h);
    }
    [h | v@freevar] -> {
      size_t len = showToBuf(buf, h);
      buf[len++] = ' ';
      buf[len++] = '|';
      buf[len++] = ' ';
      return len + showToBuf(buf + len, v);
    }
    [] -> {
      return 0;
    }
  }
}

template<typename a>
size_t show_list_max_len(list<a> l) {
  return _show_list_contents_max_len(l) + 2;
}

template<typename a>
size_t show_list_to_buf(char *buf, list<a> l) {
  size_t len = 0;
  buf[len++] = '[';
  len += _show_list_contents_to_buf(buf + len, l);
  buf[len++] = ']';
  buf[len] = '\0';
  return len;
}

template<typename a>
_Bool unify_list(list<a> l1, list<a> l2, unification_trail trail) {
  return match (l1, l2)
    ([h1 | t1], [h2 | t2] -> unify(h1, h2, trail) && unify(t1, t2, trail);
     [], [] -> 1;
     _, _ -> 0;);
}

prolog {
  append<typename a>(list<a?> ?, list<a?> ?, list<a?> ?);
  reverse<typename a>(list<a?> ?, list<a?> ?);
  length<typename a>(list<a?> ?, size_t ?);
  member<typename a>(a ?item, list<a ?> ?l);
  select<typename a>(a ?item, list<a ?> ?l1, list<a ?> ?l2);
  subset<typename a>(list<a ?> ?sub, list<a ?> ?l);
  nth<typename a>(list<a?> ?l, size_t ?n, a? item);
  nth_det<typename a>(list<a?> ?l, size_t n, a? item);
  nth_gen<typename a>(list<a?> ?l, size_t ?n, a? item);
  sort<typename a, int (*cmp)(k, k)>(list<a?>, list<a?> ?);
  insert<typename a, int (*cmp)(k, k)>(a, list<a?>, list<a?> ?);

  #include <list.pl>
}

#endif
